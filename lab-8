#include <stdlib.h>
#include <stdio.h>
#include <windows.h>
#include <time.h>

// выделение места под поле
char **m_for_matrix(int N) {
    char **matrix = malloc(N * sizeof(char *));
    for (int i = 0; i < N; i++) {matrix[i] = malloc(N * sizeof(char));}
    return matrix;
}
// освобождение места
void free_matrix(char **matrix, int N) {
    for (int i = 0; i < N; i++) {free(matrix[i]);}
    free(matrix);
}

// счетчик мин, рядом стоящих с открытой клеткой
int counter_near_mines(char **mines_matrix, int N, int i, int j) {
    int cnt = 0; 
    for (int left_right = -1; left_right <= 1; left_right++){
        for (int up_down = -1; up_down <= 1; up_down++){
            if (left_right != 0 || up_down != 0) { //не сама клетка
                int vert = i + left_right;
                int gor = j + up_down;
                if (vert >= 0 && vert < N && gor >= 0 && gor < N && mines_matrix[vert][gor] == '*') {
                    cnt++;
                }
            }
        }
    }
    return cnt;
}

// отображение поля
void print_visible_matrix(char **vis_matrix, int N, int cnt_mines){
    // нумерация поля
    printf("    ");
    for (int num_col = 1; num_col <= N; num_col++) {printf("%2d ", num_col);}
    printf("\n");

    for (int i = 0; i < N; i++) {
        printf("%3d ", i + 1); //нумерация поля
        for (int j = 0; j < N; j++){
            printf(" %c ", vis_matrix[i][j]);
        }
        printf("\n");
    }
    printf("Осталось мин: %d", cnt_mines);
}

// рекурсивное открытие безопасных клеток
void open_empty(char ** mines_matrix, char **vis_matrix, int N, int i, int j, int *opened) {
    // моменты скипа
    if (i < 0 || j < 0 || i >= N || j >= N) {return;} //выход за границы
    if (vis_matrix[i][j] != '.') {return;}

    int cnt = counter_near_mines(mines_matrix, N, i, j);
    if (cnt == 0) {vis_matrix[i][j] = ' ';} //открытие самой клетки
    else {vis_matrix[i][j] = '0' + cnt;}

    (*opened)++; 

    if (cnt == 0) { //открытие смежных 
        for (int l_r = -1; l_r <= 1; l_r++) {
            for (int u_d = -1; u_d <= 1; u_d++) {
                if (l_r == 0 && u_d == 0) {continue;}
                open_empty(mines_matrix, vis_matrix, N, i + l_r, j + u_d, opened);
            }
        }
    }
}

// -_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_

int main(void) {
    SetConsoleOutputCP(CP_UTF8);
    
    int N;
    int mines;
    int flags = 0; 
    printf("Введите N и количество мин: ");
    scanf("%d %d", &N, &mines);

    // создание и заполнение матриц
    char **vis_matrix = m_for_matrix(N);
    char **mines_matrix = m_for_matrix(N);
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            vis_matrix[i][j] = '.'; mines_matrix[i][j] = '.'; 
        }
    }

    char lose = 0; //чек
    int opened = 0; //открытые клетки
    int placed_mines = 0; //вспомогательная, для легкого старта
    srand(time(NULL));

    while (lose != 1) {
        // басик
        print_visible_matrix(vis_matrix, N, mines - flags); //отрисовка поля
        int r; //строка (в человеческом исчислении)
        int c; //столбец (в человеческом исчислении)
        char command;
        printf("\nВведите команду:\n");
        printf("Открыть ячейку - 'o' строка столбец\n");
        printf("Поставить флаг - 'f'/'F' строка столбец\n\n");
        scanf(" %c %d %d", &command, &r, &c);

        // шоб удобнее (в индексах)
        int row = r - 1; //строка
        int col = c - 1; //столбец

        if (row < 0 || row >= N || col < 0 || col >= N) {printf("Неверный диапазон\n"); continue;}

        // начало игры
        if (command == 'F' || command == 'f') {
            if (vis_matrix[row][col] == 'F') {printf("Уже поставлен флаг в этой ячейке\n");}
            else if (vis_matrix[row][col] != '.') {printf("Уже открытая ячейка\n");}
            else {vis_matrix[row][col] = 'F'; flags++;}
        }
        else if (command == 'o') {
            // легкий старт
            if (placed_mines == 0) {
                int placed = 0;
                while (placed < mines) {
                    int i = rand() % N; int j = rand() % N;
                    if (abs(i - row) <= 1 && abs(j - col) <= 1) {continue;} //чтоб слишком близко мины не были
                    if (mines_matrix[i][j] == '.') {
                        mines_matrix[i][j] = '*';
                        placed++;
                    }
                }
                placed_mines = 1;
            }

            if (vis_matrix[row][col] == 'F') {printf("Уже поставлен флаг в этой ячейке\n");}
            else if (vis_matrix[row][col] != '.') {printf("Эта ячейка уже открыта\n");}
            else if (mines_matrix[row][col] == '*') {lose = 1; printf("\n___Здесь была мина!___\n");}
            else {
                open_empty(mines_matrix, vis_matrix, N, row, col, &opened); //открыть рекурсивно
                if (opened == N*N - mines) {printf("\n___Победа___\n"); break;}
            }
        }
    }

    printf("\n___Статистика___\n");
    printf("Открыто клеток %d из %d \n", opened, N * N - mines);
    printf("Поставлено флагов: %d \n", flags);
    printf("Осталось мин: %d\n", mines - flags);

    free_matrix(vis_matrix, N);
    free_matrix(mines_matrix, N);

    return 0;
}
